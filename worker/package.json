{
  "name": "classsync-worker",
  "version": "0.1.0",
  "private": true,
  "description": "ClassSync - Class Widgets 2 课表同步后端 (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute classsync --remote --file=./migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute classsync --local --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
